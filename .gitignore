# build output
*.o
*.map
*.elf

# ROMS and ROM related files
*.gba
*.sav
*.ss?
*.sa?
*.sg?
*.SNA

# backup directory in case of text archive build falure
data/textscript/compressed/backup_lz/

# remove build files for compressed textscripts
data/textscript/compressed/*.lz
data/textscript/compressed/*.bin

# atom-specific settings
.atom*
*.json

# python generated files/folders
__pycache__/

# compiled python bytecode files
*.pyc

# clion settings
.idea/

# cache files for heavy computations
.cache/

# vim files
*.swp
*.swo
*.sw*
tags

# intentionally ignore those junk/temp files
*.ign

# compare.sh and other misc dumps
baserom.txt
bn6f.txt
*.txt
# but keep tracker baselines (parity-check fixtures for the harness)
!tests/fixtures/*.txt

# asmdiff.sh
*.dump

# tools
*.exe
tools/agbcc/
tools/binutils/

# Rust build artifacts under tools/bn6f-track
tools/bn6f-track/target/

# Per-call entry/exit fixtures — ~40 MB per function-call session, tied
# to a specific ROM build. Regenerated by `make verify`. Commit
# selected canonical ones via git-LFS if/when we want regression
# guarantees in CI.
tests/fixtures/calls/
*.pickle
temp/
*.cfg
*.rsync
*.sym
